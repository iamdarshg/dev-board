				(size 1.27 1.27)
			)
		)
		(uuid "db6485bd-6e25-4fc9-84fe-3d6c2dbb54e5")
	)
	(text "Follow TI/Johanson layout: keep IPC close to CC1352 RF pins, symmetric short RF traces, and GND vias by RF ground pads."
