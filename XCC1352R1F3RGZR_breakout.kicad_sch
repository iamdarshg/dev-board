			)
		)
		(uuid "c6f143f7-fcff-4332-b193-29e2dfb9b0fa")
	)
	(text "RF section: Johanson 0900PC15A0036 matched-filter/balun IPC + SPDT common antenna path from TI CC1352 IPC reference."
		(exclude_from_sim no)
		(at 30 162 0)
		(effects
