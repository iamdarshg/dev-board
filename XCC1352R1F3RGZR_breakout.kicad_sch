	(text "RF frontend uses Johanson 0900PC15A0036 IPC: matched balun/filter for 862-928 MHz + 2.4-2.5 GHz."
		(exclude_from_sim no)
		(at 210 112 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "66b3bc45-0aa2-45b2-8017-76475012068f")
	)
	(text "CANT1/RANT1/CANT2 form antenna tuning placeholders. Tune with VNA on final PCB/antenna layout."
		(exclude_from_sim no)
		(at 210 124 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "67838c59-b8fd-4d72-b301-5596dbe0958a")
	)
	(text "U2 selects 2.4 GHz vs sub-1 GHz path; CTL tied to DIO_30 as in the TI CC1352R IPC reference."
		(exclude_from_sim no)
		(at 210 118 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "86b6e6f6-50f8-459c-815c-8b44b1b16bde")
	)
	(text "XCC1352R1F3RGZR breakout: 3.3 V input, all 28 GPIO as hierarchical labels, cJTAG/JTAG debug header."
		(exclude_from_sim no)
		(at 30 150 0)
		(effects
