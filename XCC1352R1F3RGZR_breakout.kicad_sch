				(size 1.27 1.27)
			)
		)
		(uuid "9b4f8dac-67bf-4d63-a6bd-d3df0ac9ed54")
	)
	(text "No native USB pins exist on this part; USB connector intentionally omitted. Use external USB-UART if required."
		(exclude_from_sim no)
		(at 30 156 0)
		(effects
